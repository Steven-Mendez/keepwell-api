{
  "name": "keepwell-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/entrypoints/dev.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "TZ=America/Managua vitest run",
    "test:watch": "TZ=America/Managua vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "scripts/generate-migration.sh",
    "test:remote": "vitest run --config vitest.remote.config.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "grant": "tsx scripts/grant.ts",
    "invite": "tsx scripts/invite.ts",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-sqs": "^3.1164.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@aws/aurora-dsql-drizzle": "^0.2.0",
    "@aws/aurora-dsql-node-postgres-connector": "^0.1.9",
    "@better-auth/cimd": "1.7.18",
    "@better-auth/mcp": "1.7.18",
    "@better-auth/oauth-provider": "1.7.18",
    "@better-auth/passkey": "1.7.18",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-auth": "^1.7.18",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@hono/node-server": "^2.1.6",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
